    <mxGraphModel dx="2824" dy="1686" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: BCA POC ETL Architecture by Scenario\nconfig:\n  layout: elk\n---\nflowchart LR\n  ORCH[\&quot;Orchestration&lt;br/&gt;Airflow DAGs&lt;br/&gt;Control-M / Jenkins integration\&quot;]:::orchestration\n\n  subgraph S1[\&quot;Scenario 1 — Investor Account Dimension\&quot;]\n    S1SRC[\&quot;MProductOwnership.txt&lt;br/&gt;fixed-width\&quot;]:::source\n    S1PY[\&quot;Python + oracledb&lt;br/&gt;parse, deduplicate, bulk load\&quot;]:::python\n    S1STG[\&quot;Oracle temporary/staging table&lt;br/&gt;branch + product lookups\&quot;]:::database\n    S1MERGE[\&quot;Oracle MERGE&lt;br/&gt;insert / update / unchanged\&quot;]:::oracle\n    S1TGT[\&quot;Oracle target&lt;br/&gt;CIPS_INVESTOR_ACCT_DIMENSION\&quot;]:::target\n    S1SRC --&gt; S1PY --&gt; S1STG --&gt; S1MERGE --&gt; S1TGT\n  end\n\n  subgraph S2[\&quot;Scenario 2 — Product Dimension\&quot;]\n    S2SRC[\&quot;MProduct.txt +&lt;br/&gt;MProductOwnership.txt&lt;br/&gt;fixed-width\&quot;]:::source\n    S2SPARK[\&quot;PySpark&lt;br/&gt;parse, inner join, transform,&lt;br/&gt;deduplicate, assign keys\&quot;]:::spark\n    S2LOOK[\&quot;Oracle JDBC lookups&lt;br/&gt;currency + existing product keys\&quot;]:::database\n    S2STG[\&quot;Oracle staging&lt;br/&gt;CIPS_PRODUCT_DIMENSION_STAGE\&quot;]:::database\n    S2MERGE[\&quot;Oracle MERGE&lt;br/&gt;insert / update / unchanged\&quot;]:::oracle\n    S2TGT[\&quot;Oracle target&lt;br/&gt;CIPS_PRODUCT_DIMENSION\&quot;]:::target\n    S2SRC --&gt; S2SPARK\n    S2LOOK -.-&gt; S2SPARK\n    S2SPARK --&gt; S2STG --&gt; S2MERGE --&gt; S2TGT\n  end\n\n  subgraph S3[\&quot;Scenario 3 — OMNI Activity Logs\&quot;]\n    S3SRC[\&quot;TBL_ACTIVITY_LOG.avro&lt;br/&gt;raw activity events\&quot;]:::source\n    S3RAW[\&quot;fastavro batch ingestion&lt;br/&gt;raw staging\&quot;]:::python\n    S3ORAW[\&quot;Oracle raw staging&lt;br/&gt;STG_TBL_ACTIVITY_LOG\&quot;]:::database\n    S3HRAW[\&quot;Hive/Impala raw staging&lt;br/&gt;activity log table\&quot;]:::database\n    S3SQL[\&quot;Oracle SQL transform&lt;br/&gt;regex, date logic, dimension joins\&quot;]:::oracle\n    S3SPARK[\&quot;PySpark / Spark SQL option&lt;br/&gt;in-memory or chunked processing\&quot;]:::spark\n    S3DUCK[\&quot;DuckDB alternative&lt;br/&gt;memory-limited, disk spill\&quot;]:::duck\n    S3OTGT[\&quot;Oracle transformed target&lt;br/&gt;STG_OMNI variants\&quot;]:::target\n    S3HTGT[\&quot;Hive/Impala final target&lt;br/&gt;copy of transformed result\&quot;]:::target\n    S3SRC --&gt; S3RAW\n    S3RAW --&gt; S3ORAW\n    S3RAW --&gt; S3HRAW\n    S3ORAW --&gt; S3SQL --&gt; S3OTGT\n    S3HRAW --&gt; S3SPARK --&gt; S3OTGT\n    S3HRAW --&gt; S3DUCK --&gt; S3OTGT\n    S3OTGT --&gt; S3HTGT\n  end\n\n  subgraph S4[\&quot;Scenario 4 — User Script Orchestration\&quot;]\n    S4META[\&quot;POC_ORCHESTRATION&lt;br/&gt;job/session metadata\&quot;]:::database\n    S4PY[\&quot;Python user script&lt;br/&gt;read SQL, check sessions,&lt;br/&gt;record status and row counts\&quot;]:::python\n    S4SQL[\&quot;SQL files&lt;br/&gt;session-level ETL statements\&quot;]:::source\n    S4DB[\&quot;Oracle or Impala/Hive&lt;br/&gt;SQL execution targets\&quot;]:::target\n    S4META --&gt; S4PY\n    S4SQL --&gt; S4PY --&gt; S4DB\n    S4PY --&gt; S4META\n  end\n\n  ORCH -.-&gt; S1PY\n  ORCH -.-&gt; S2SPARK\n  ORCH -.-&gt; S3RAW\n  ORCH -.-&gt; S3SQL\n  ORCH -.-&gt; S3SPARK\n  ORCH -.-&gt; S3DUCK\n  ORCH -.-&gt; S4PY\n  S2TGT -. dependency: product keys .-&gt; S1STG\n  S3SQL -. completion gate .-&gt; S3HTGT\n\n  subgraph LEGEND[\&quot;Legend\&quot;]\n    LD[\&quot;Solid arrow = data movement\&quot;]:::legend\n    LO[\&quot;Dashed arrow = orchestration or dependency\&quot;]:::legend\n    LP[\&quot;Blue = PySpark / Spark SQL\&quot;]:::spark\n    LX[\&quot;Purple = Python / fastavro\&quot;]:::python\n    LS[\&quot;Gray = Oracle SQL, Hive/Impala, or DuckDB\&quot;]:::oracle\n  end\n\n  classDef orchestration fill:#FFF6E0,stroke:#E8C36A,color:#1B1F24,stroke-width:2px\n  classDef source fill:#F3EEFF,stroke:#B9A6F0,color:#1B1F24\n  classDef python fill:#F3EEFF,stroke:#9673A6,color:#1B1F24\n  classDef spark fill:#EEF4FF,stroke:#6C8EBF,color:#1B1F24,stroke-width:2px\n  classDef database fill:#F2F4F7,stroke:#B8C0CC,color:#1B1F24\n  classDef oracle fill:#FFF0E5,stroke:#D79B00,color:#1B1F24\n  classDef duck fill:#E7F6EC,stroke:#8BCB9F,color:#1B1F24\n  classDef target fill:#E7F6EC,stroke:#82B366,color:#1B1F24,stroke-width:2px\n  classDef legend fill:#FFFFFF,stroke:#B8C0CC,color:#1B1F24\n  linkStyle default stroke:#8A94A6\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="70">
